# Public domain the reverse proxy serves over HTTPS.
DOMAIN=chordtune.example.com
# Image tag: a release version such as 0.2.0, or latest.
CHORDTUNE_VERSION=latest
# Host port on 127.0.0.1 the reverse proxy forwards to.
APP_PORT=3000
# Generate with `openssl rand -hex 24`; it goes into a URL, so keep it to letters and digits.
POSTGRES_PASSWORD=
# Generate with `openssl rand -hex 24`; Meilisearch requires at least 16 bytes in production.
MEILI_MASTER_KEY=
# Comma-separated emails of accounts that may fix artist links (photo and Wikipedia article).
ADMIN_EMAILS=

# Sign-in. Every provider is optional: without its keys the button is hidden. Without SMTP_URL,
# sign-in by email code fails in production with "could not send the code" (codes are only logged
# in development) — and former password users sign in by email code, so set it before upgrading.
SMTP_URL=
MAIL_FROM="ChordTune <no-reply@localhost>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# From @BotFather; the bot's domain must be set with /setdomain.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# A store-review account: this email always accepts this code and gets no mail. Anyone who learns
# the pair can sign in, so set them only for the duration of a store review.
REVIEW_EMAIL=
REVIEW_CODE=
# Passkeys in the apps: Apple team id (paid account) and the APK signing key SHA-256.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
