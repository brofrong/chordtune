# Public domain the reverse proxy serves over HTTPS.
DOMAIN=chordtune.example.com
# Image tag: a release version such as 0.2.0, or latest.
CHORDTUNE_VERSION=latest
# Host port on 127.0.0.1 the reverse proxy forwards to.
APP_PORT=3000
# Generate with `openssl rand -hex 24`; it goes into a URL, so keep it to letters and digits.
POSTGRES_PASSWORD=
# Generate with `openssl rand -hex 24`; Meilisearch requires at least 16 bytes in production.
MEILI_MASTER_KEY=
