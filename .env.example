# apps/api
DATABASE_URL=postgres://chordtune:chordtune@localhost:5432/chordtune
BETTER_AUTH_URL=http://localhost:4000
API_PORT=4000
WEB_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost
MEILI_URL=http://localhost:7700
MEILI_KEY=chordtune-dev-master-key
# Comma-separated emails of accounts that may fix artist links
ADMIN_EMAILS=

# Sign-in. Every provider is optional: without its keys the button is hidden.
# Email codes: any SMTP provider (Unisender Go, Resend, Brevo, SES…). Without SMTP_URL codes go to
# the API log in development; in production (NODE_ENV=production) sending fails.
SMTP_URL=
MAIL_FROM="ChordTune <no-reply@localhost>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# From @BotFather; the bot's domain must be set with /setdomain.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# A store-review account: this email always accepts this code and gets no mail. Anyone who learns
# the pair can sign in, so set them only for the duration of a store review.
REVIEW_EMAIL=
REVIEW_CODE=
# Passkeys in the apps: Apple team id (paid account) and the APK signing key SHA-256.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# apps/web
# Capacitor build only; the web build calls the API through its own origin
NEXT_PUBLIC_API_URL=http://localhost:4000
